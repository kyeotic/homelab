# Forward-auth gate. Add `import tinyauth` to a handle block to require a
# Pocket ID login for it. Never import it in the @auth or @tinyauth handles.
(tinyauth) {
	forward_auth 192.168.0.20:3200 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
	}
}

# Gated *arr app. Usage: import gated-arr <subdomain> <upstream>
# API-key clients (Jellyseerr, mobile apps, calendar feeds) and health checks
# skip the gate; the app still enforces its API key on those paths. The app runs
# with External auth, but still serves a dead form at /login that stale
# bookmarks land on, so that path is sent to the app root.
(gated-arr) {
	@{args[0]}-api {
		host {args[0]}.local.kye.dev
		path /api/* /feed/* /ping
	}
	handle @{args[0]}-api {
		reverse_proxy {args[1]}
	}

	@{args[0]} host {args[0]}.local.kye.dev
	handle @{args[0]} {
		redir /login / 302
		import tinyauth
		reverse_proxy {args[1]}
	}
}

homelab.kye.dev {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	reverse_proxy https://192.168.0.10:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

