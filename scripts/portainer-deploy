#!/usr/bin/env bash
set -euo pipefail

PORTAINER_URL="https://192.168.0.20:9443"
PORTAINER_ENDPOINT_ID=2
PORTAINER_API_KEY_BWS_ID="3627973b-9a14-44f5-9a5a-b3e3006cc4ae"

usage() {
  echo "Usage: portainer-deploy <stack-name> <compose-file> [bws-secret-id]"
  echo ""
  echo "Deploy a stack to Portainer via the API."
  echo ""
  echo "Arguments:"
  echo "  stack-name      Name of the Portainer stack"
  echo "  compose-file    Path to the Docker Compose file"
  echo "  bws-secret-id   Optional BWS secret ID containing env vars (KEY=VALUE per line)"
  echo ""
  echo "Requires: bws, jq, curl"
  exit 1
}

if [[ $# -lt 2 ]]; then
  usage
fi

APP_NAME="$1"
COMPOSE_FILE="$2"
BWS_SECRET_ID="${3:-}"

# Get Portainer API key from BWS
PORTAINER_API_KEY=$(bws secret get "$PORTAINER_API_KEY_BWS_ID" --output json | jq -r '.value')

COMPOSE_CONTENT=$(cat "$COMPOSE_FILE")

# Build env JSON array from BWS secret
if [[ -n "$BWS_SECRET_ID" ]]; then
  ENV_JSON=$(bws secret get "$BWS_SECRET_ID" --output json | \
    jq '[.value | split("\n")[] | select(length > 0 and (startswith("#") | not)) |
      capture("^(?<name>[^=]+)=(?<value>.*)$")]')
else
  ENV_JSON="[]"
fi

portainer() { curl -sk "$PORTAINER_URL$1" -H "X-API-Key: $PORTAINER_API_KEY" "${@:2}"; }

# Check if stack already exists
STACK_ID=$(portainer /api/stacks | jq -r ".[] | select(.Name == \"$APP_NAME\") | .Id")

if [[ -n "$STACK_ID" ]]; then
  echo "Updating stack $APP_NAME..."
  portainer "/api/stacks/$STACK_ID?endpointId=$PORTAINER_ENDPOINT_ID" \
    -X PUT -H "Content-Type: application/json" \
    -d "$(jq -n --arg c "$COMPOSE_CONTENT" --argjson e "$ENV_JSON" \
      '{stackFileContent: $c, env: $e, prune: true, pullImage: true}')"
else
  echo "Creating stack $APP_NAME..."
  portainer "/api/stacks/create/standalone/string?endpointId=$PORTAINER_ENDPOINT_ID" \
    -X POST -H "Content-Type: application/json" \
    -d "$(jq -n --arg n "$APP_NAME" --arg c "$COMPOSE_CONTENT" --argjson e "$ENV_JSON" \
      '{name: $n, stackFileContent: $c, env: $e}')"
fi

echo "Done."
